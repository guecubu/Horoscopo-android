<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_background"
        app:cardElevation="10dp"
        app:cardCornerRadius="12dp"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/detailIconImageView"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/iconDescription"
            android:padding="8dp"
            tools:src="@drawable/aries_icon" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/detailNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textStyle="bold"
        tools:text="Aries" />

    <TextView
        android:id="@+id/detailDatesTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        tools:text="March 21 - April 19" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_background"
            app:cardElevation="10dp"
            app:cardCornerRadius="12dp"
            android:layout_marginHorizontal="16dp">

            <ProgressBar
                android:id="@+id/detailProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:layout_gravity="center_horizontal|center_vertical" />

            <TextView
                android:id="@+id/detailHoroscopeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                tools:text="Horoscope description loading..."
                android:justificationMode="inter_word"
                android:layout_gravity="center_horizontal|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" />
        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/buttonGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:checkedButton="@+id/buttonToday"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonToday"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todayView" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonWeekly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weekly" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMonthly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monthly" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
